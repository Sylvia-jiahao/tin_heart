static func get_room(index: int) -> Dictionary:
	var zone: int = index/5
	var platforms: Array = []
	platforms.append({"x":0.0,"y":650.0,"w":190.0,"kind":"wood"})
	for i in range(ROUTES[index].size()):
		var p: Array = ROUTES[index][i]
		var kind := "wood"
		var motion := Vector2.ZERO
		if zone==3 or index==26:
			if i%2==0:
				kind="ruler"
				motion=Vector2(45,0) if index%5!=1 else Vector2(0,45)
		if zone==4 or index==25 or index==28:
			if i%2==0 or index==21:
				kind="paper"
		platforms.append({"x":float(p[0]),"y":float(p[1]),"w":float(p[2]),"kind":kind,"motion":motion,"period":4.0+float(i%2),"phase":float(i)*1.1})
	var finish_y: float = 590.0 if index!=29 else 550.0
	platforms.append({"x":1090.0,"y":finish_y,"w":190.0,"kind":"wood"})
	if index in [2,12]:
		# Wider final books keep the low passage jump reachable without side-cover footholds.
		platforms[-1].x=1050.0
		platforms[-1].w=230.0
	var ceiling: Array = []
	if index in [2,12,17,22,27]:
		ceiling=[370.0,300.0,660.0,45.0]
	var swings: Array = []
	if (zone==2 and index!=12) or index in [26,28]:
		swings.append({"pivot":Vector2(635,125),"length":350.0 if index%5!=2 else 400.0,"period":3.8,"phase":0.0})
		if index==28:
			swings.append({"pivot":Vector2(960,100),"length":300.0,"period":4.5,"phase":1.7})
	var wind_strength: float = 0.0
	if zone==1 or index in [25,28]:
		wind_strength=440.0 if index%2==0 else -500.0
	var star_platform: Dictionary = platforms[mini(3,platforms.size()-2)]
	var branches: Array=[]
	var star_at:=Vector2(star_platform.x+star_platform.w*0.5,star_platform.y-155)
	if index in [3,8,13,18,23,28]:
		var upper: Dictionary={"x":star_platform.x+star_platform.w*0.5-40,"y":star_platform.y-110,"w":80.0,"kind":"wood"}
		branches.append(upper)
		star_at=Vector2(upper.x+40,upper.y-50)
	return {"name":TITLES[index],"zone":ZONES[zone],"background":BACKGROUNDS[zone],"hint":HINTS[index],"platforms":platforms,"branches":branches,"ceiling":ceiling,"swings":swings,"wind":wind_strength,"star":star_at,"finish_y":finish_y}
